{
  "name": "eventforge-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:backend": "esbuild backend/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js",
    "deploy:aws": "python3 scripts/deploy-aws.py",
    "test": "tsx --test tests/backend.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components backend lib tests *.json next.config.js playwright.config.ts README.md"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1157.0",
    "@aws-sdk/lib-dynamodb": "^3.1157.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
